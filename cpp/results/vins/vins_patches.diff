+    {
+        nav_msgs::msg::Odometry extrinsic;
+        extrinsic.header = header;
+        extrinsic.header.frame_id = WORLD_FRAME_ID;
+        extrinsic.pose.pose.position.x = estimator.tic[0].x();
+        extrinsic.pose.pose.position.y = estimator.tic[0].y();
+        extrinsic.pose.pose.position.z = estimator.tic[0].z();
+        Quaterniond q_ic{estimator.ric[0]};
+        extrinsic.pose.pose.orientation.x = q_ic.x();
+        extrinsic.pose.pose.orientation.y = q_ic.y();
+        extrinsic.pose.pose.orientation.z = q_ic.z();
+        extrinsic.pose.pose.orientation.w = q_ic.w();
+        pub_extrinsic->publish(extrinsic);
+    }
     return; // tmp.
 
 
